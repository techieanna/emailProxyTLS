# Secret references only (NOT raw passwords).
# Use one global fallback:
PSFT_SECRET_REF=oracle-wallet://weblogic/admin-default

# Optional per-environment overrides (recommended when creds differ by env):
PSFT_SECRET_REF_DEV=oracle-wallet://weblogic/admin-dev
PSFT_SECRET_REF_TEST=oracle-wallet://weblogic/admin-test
PSFT_SECRET_REF_UAT=oracle-wallet://weblogic/admin-uat
PSFT_SECRET_REF_PRE_PROD=oracle-wallet://weblogic/admin-preprod

# Notes:
# - PRE-PROD env name maps to PRE_PROD variable key.
# - Values should be secret aliases/references in Vault/CyberArk/Oracle Wallet.
# - Do not commit real values.
